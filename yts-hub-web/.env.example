# YTS Hub — environment variables
# Salin file ini menjadi .env lalu isi. Jangan commit .env.

# Connection string PostgreSQL.
# Pengembangan lokal:  postgres://postgres@localhost:5432/ytshub
# Staging/production:  connection string Neon (mengandung .neon.tech)
# Driver dipilih otomatis dari URL ini — Neon HTTP untuk Neon, postgres.js untuk lainnya.
DATABASE_URL=""

# Database terpisah untuk test integrasi. Isinya DIHAPUS setiap kali test berjalan,
# jadi jangan pernah arahkan ke database yang berisi data sungguhan.
DATABASE_URL_TEST=""

PUBLIC_SITE_URL="http://localhost:4321"
