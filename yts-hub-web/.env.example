# YTS Hub — environment variables
# Salin file ini menjadi .env lalu isi. Jangan commit .env.

# Connection string PostgreSQL.
# Pengembangan lokal:  postgres://postgres@localhost:5432/ytshub
# Staging/production:  connection string Neon (mengandung .neon.tech)
# Driver dipilih otomatis dari URL ini — Neon WebSocket untuk Neon, postgres.js
# untuk lainnya. Keduanya mendukung transaksi, yang dibutuhkan audit log Fase 5.
DATABASE_URL=""

# Database terpisah untuk test integrasi. Isinya DIHAPUS setiap kali test berjalan,
# jadi jangan pernah arahkan ke database yang berisi data sungguhan.
DATABASE_URL_TEST=""

# Origin publik situs. Dipakai better-auth untuk menyusun URL dan memvalidasi
# asal permintaan, jadi di production ini WAJIB domain sungguhan — bukan localhost.
PUBLIC_SITE_URL="http://localhost:4321"

# Kunci penanda tangan cookie sesi admin (Fase 5).
# Hasilkan sekali, simpan sebagai secret, jangan pernah di-commit:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# Mengganti nilai ini membuat seluruh sesi yang sedang berjalan tidak berlaku.
BETTER_AUTH_SECRET=""
