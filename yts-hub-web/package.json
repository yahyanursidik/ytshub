{
  "name": "yts-hub-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "YTS Hub — public web (Astro + React islands). Fase 0-1.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "cd .. && astro dev --root yts-hub-web",
    "start": "npm run dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,astro,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro,css,md,json}\"",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:links && npm run budget",
    "shot": "node tools/screenshot.mjs",
    "audit:a11y": "node tools/audit.mjs",
    "check:links": "node tools/check-links.mjs",
    "db:check": "tsx scripts/db.ts check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:seed:clear": "tsx scripts/db.ts seed:clear",
    "db:status": "tsx scripts/db.ts status",
    "db:studio": "drizzle-kit studio",
    "admin:user": "tsx scripts/admin.ts",
    "links:check": "tsx scripts/links.ts check",
    "links:report": "tsx scripts/links.ts report",
    "budget": "node tools/budget.mjs",
    "db:backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.4",
    "@astrojs/react": "6.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "astro": "7.2.8",
    "better-auth": "1.7.2",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
