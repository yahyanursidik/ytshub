---
/**
 * Ekosistem pembelajaran online YTS.
 *
 * ## Kenapa halaman sendiri, bukan hanya baris di /aplikasi
 *
 * Di registry, kedua sistem ini berdiri sebagai dua baris di antara sembilan
 * lainnya — satu bertipe `aplikasi`, satu `portal`, dimiliki dua unit berbeda.
 * Yang tidak terbaca di sana adalah bahwa keduanya adalah satu hal bagi
 * pengguna: tempat belajar. Halaman ini yang menyatakannya.
 *
 * ## Yang dijawab halaman ini
 *
 * Pertanyaan yang membuat orang tersesat bukan "sistem apa saja yang ada",
 * melainkan "saya harus masuk yang mana". Karena itu tiap sistem disertai
 * keterangan UNTUK SIAPA ia dibuat — jamaah kajian, atau peserta program BID —
 * dan bukan sekadar nama beserta tombolnya.
 *
 * Program yang berjalan ikut ditampilkan di bawah, karena sebagian pengunjung
 * datang ke sini belum menjadi peserta apa pun: mereka perlu tahu apa yang bisa
 * diikuti lebih dulu, bukan portal untuk masuk.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import EmptySection from '@/components/ui/EmptySection.astro';
import { getLearningSystems } from '@/server/content/public-queries';
import { listPrograms } from '@/server/content/directory-queries';
import { linkStatusFor } from '@/server/integrations/link-monitor';

const [systems, programs] = await Promise.all([getLearningSystems(), listPrograms()]);

const linkStatus = await linkStatusFor(
  'application',
  systems.map((system) => system.id),
);
const isBroken = (id: string) => linkStatus.get(`${id}:url`) === 'broken';

/** Program yang relevan dengan belajar daring, diurutkan yang sedang berjalan dulu. */
const learningPrograms = programs
  .filter((program) => program.programStatus !== 'selesai')
  .slice(0, 4);

const KIND_LABEL: Record<string, string> = {
  aplikasi: 'Aplikasi',
  website: 'Website',
  portal: 'Portal',
};
---

<BaseLayout
  title="Belajar di ekosistem pembelajaran online kami"
  description="Sistem pembelajaran daring Yayasan Tarbiyah Sunnah: ruang belajar jamaah kajian dan peserta program Belajar Islam Dasar."
  canonicalPath="/belajar"
>
  <PageHeader
    eyebrow="Pembelajaran"
    title="Belajar di ekosistem pembelajaran online kami"
    lead="Yayasan Tarbiyah Sunnah menyediakan ruang belajar daring untuk jamaah kajian dan peserta program. Pilih sistem sesuai keperluan Anda."
    crumbs={[{ label: 'Beranda', href: '/' }, { label: 'Belajar' }]}
  />

  <div class="container learn">
    {
      systems.length === 0 ? (
        <EmptySection
          message="Sistem pembelajaran belum terdaftar."
          hint="Tandai registry aplikasi dengan kategori 'pembelajaran' agar muncul di sini."
        />
      ) : (
        <section aria-labelledby="sistem">
          <h2 id="sistem" class="visually-hidden">
            Sistem pembelajaran
          </h2>
          <ul class="systems">
            {systems.map((system) => (
              <li>
                <p class="systems__meta">
                  <span class="systems__kind">{KIND_LABEL[system.kind] ?? system.kind}</span>
                  <a href={`/unit/${system.unitSlug}`}>{system.unitName}</a>
                </p>
                <h3>{system.name}</h3>
                <p class="systems__summary">{system.summary}</p>

                {system.url && isBroken(system.id) ? (
                  <p class="systems__broken">
                    Sedang tidak bisa dibuka.
                    <span>Sudah dilaporkan ke unit pemiliknya.</span>
                  </p>
                ) : system.url ? (
                  <a
                    class="btn btn--primary systems__cta"
                    href={system.url}
                    target="_blank"
                    rel="noopener"
                  >
                    {system.ctaLabel}
                    <Icon name="external" size={16} />
                    <span class="visually-hidden">
                      {system.name} — membuka situs di luar YTS Hub, di tab baru
                    </span>
                  </a>
                ) : (
                  <p class="systems__pending">Tautan belum tersedia.</p>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      learningPrograms.length > 0 && (
        <section class="programs" aria-labelledby="program">
          <h2 id="program">Belum menjadi peserta?</h2>
          <p class="programs__lead">
            Sistem di atas untuk yang sudah terdaftar. Bila Anda baru ingin mulai, lihat program
            yang sedang berjalan.
          </p>
          <ul class="programs__list">
            {learningPrograms.map((program) => (
              <li>
                <a href={`/program/${program.slug}`}>
                  <h3>{program.title}</h3>
                  <p>{program.summary}</p>
                </a>
              </li>
            ))}
          </ul>
          <p class="programs__all">
            <a class="link-action" href="/program">
              Semua program
              <Icon name="arrow-right" size={16} />
            </a>
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .learn {
    padding-block: var(--space-10) var(--space-16);
  }

  .systems {
    display: grid;
    gap: var(--space-4);
  }

  .systems > li {
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .systems__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .systems__kind {
    color: var(--color-brand);
    font-weight: 600;
  }

  .systems h3 {
    margin-top: var(--space-2);
    font-size: var(--text-h4);
  }

  .systems__summary {
    max-width: 62ch;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .systems__cta {
    margin-top: var(--space-4);
  }

  .systems__pending {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .systems__broken {
    margin-top: var(--space-4);
    color: var(--color-danger);
    font-weight: 550;
  }

  .systems__broken span {
    display: block;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-weight: 400;
  }

  /* ---- program ---- */

  .programs {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .programs h2 {
    font-size: var(--text-h3);
  }

  .programs__lead {
    max-width: 66ch;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  /*
   * Program tampil sebagai daftar bergaris, BUKAN kartu seperti sistem di atas.
   * 05-HALLMARK-ANTI-SLOP.md §6 menolak grid kartu identik untuk semua bagian —
   * dan di sini bedanya juga ada artinya: yang di atas adalah tujuan akhir,
   * yang di bawah bacaan lanjutan.
   */
  .programs__list {
    margin-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .programs__list li {
    border-bottom: 1px solid var(--color-border);
  }

  .programs__list a {
    display: block;
    padding-block: var(--space-4);
    color: inherit;
    text-decoration: none;
  }

  .programs__list a:hover h3 {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .programs__list h3 {
    font-size: var(--text-body);
    font-weight: 600;
  }

  .programs__list p {
    max-width: 66ch;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .programs__all {
    margin-top: var(--space-6);
  }

  @media (min-width: 720px) {
    .systems {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    }
  }
</style>
