---
/** Detail layanan — route sesuai 02-INFORMATION-ARCHITECTURE.md §8. Isi pada Fase 3. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PhasePlaceholder from '@/components/ui/PhasePlaceholder.astro';
import { getServiceSlugs } from '@/server/content/public-queries';

export async function getStaticPaths() {
  const services = await getServiceSlugs();
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { title: service.title, summary: service.summary },
  }));
}

const { title, summary } = Astro.props;
---

<BaseLayout title={title} description={summary} noindex>
  <PhasePlaceholder title={title} phase="Fase 3 — Public Directory Routes" describes={summary} />
</BaseLayout>
