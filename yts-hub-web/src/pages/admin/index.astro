---
/**
 * Dasbor admin.
 *
 * Menjawab "apa yang perlu saya kerjakan sekarang", bukan "berapa banyak konten
 * yang kita punya". Angka ringkasan ada di bawah, setelah antrean kerjanya —
 * urutannya sengaja begitu: yang menuntut tindakan lebih dulu.
 */
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import WorkQueue from '@/components/admin/WorkQueue.astro';
import { buildDashboard } from '@/server/admin/dashboard';
import { listLinks } from '@/server/integrations/link-monitor';
import { roleFor } from '@/server/auth/roles';

// Middleware menjamin keberadaannya; pemeriksaan ini yang membuat typecheck
// ikut menjaganya bila suatu saat middleware-nya berubah.
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/admin/masuk', 302);

const dashboard = await buildDashboard(actor);

/**
 * Tautan rusak ikut ditampilkan di dasbor — 08-INTEGRATION §6 meminta "alert ke
 * admin jika broken". Peringatan yang hanya ada di halaman terpisah hanya
 * terbaca oleh orang yang sudah curiga; yang perlu tahu justru orang yang tidak.
 *
 * Hanya yang berstatus `broken` yang naik ke sini. Peringatan dan pengalihan
 * ada di /admin/tautan — memunculkan semuanya di dasbor akan membuat bagian ini
 * penuh terus-menerus dan berhenti berarti.
 */
const isOrgWide = roleFor(actor, null) !== null;
const brokenLinks = await listLinks({
  status: 'broken',
  unitIds: isOrgWide
    ? null
    : actor.assignments
        .map((assignment) => assignment.unitId)
        .filter((unitId): unitId is string => unitId !== null),
});

const isApprover = actor.assignments.some(
  (assignment) => assignment.role === 'approver' || assignment.role === 'admin',
);

const scope = isOrgWide ? 'seluruh unit' : `unit yang Anda kelola (${actor.assignments.length})`;

const COUNT_LABELS: [keyof typeof dashboard.counts, string][] = [
  ['draft', 'Draft'],
  ['in_review', 'Menunggu tinjauan'],
  ['approved', 'Disetujui'],
  ['published', 'Terbit'],
  ['needs_review', 'Perlu ditinjau'],
  ['archived', 'Arsip'],
];
---

<AdminLayout title="Dasbor" actor={actor}>
  <div class="admin-head">
    <div>
      <h1>Halo, {actor.name.split(' ')[0]}</h1>
      <p>Menampilkan konten dari {scope}.</p>
    </div>
  </div>

  {
    brokenLinks.length > 0 && (
      <section class="admin-panel broken" aria-labelledby="tautan-rusak">
        <h2 id="tautan-rusak">Tautan rusak</h2>
        <p class="broken__desc">
          Halaman publik masih menampilkan tautan ini, dan pengunjung yang menekannya tidak sampai
          ke mana-mana.
        </p>
        <ul>
          {brokenLinks.slice(0, 5).map((row) => (
            <li>
              <a href={`/admin/tautan?status=broken`}>{row.title ?? '(tanpa judul)'}</a>
              <span>{row.error ?? `HTTP ${row.httpStatus}`}</span>
            </li>
          ))}
        </ul>
        {brokenLinks.length > 5 && (
          <p class="broken__more">
            <a href="/admin/tautan?status=broken">
              Lihat seluruh {brokenLinks.length} tautan rusak
            </a>
          </p>
        )}
      </section>
    )
  }

  <WorkQueue
    title="Menunggu tinjauan"
    description={isApprover
      ? 'Konten yang sudah dikirim penyunting dan menunggu keputusan Anda.'
      : 'Konten yang Anda kirim dan sedang menunggu keputusan approver.'}
    items={dashboard.awaitingReview}
    emptyMessage="Tidak ada yang menunggu tinjauan."
  />

  <WorkQueue
    title="Jatuh tempo ditinjau ulang"
    description="Konten terbit yang sudah melewati jadwal tinjauannya. Isinya masih tampil di halaman publik — periksa apakah masih benar."
    items={dashboard.overdue}
    emptyMessage="Tidak ada konten yang terlewat jadwal tinjauannya."
    showDue
  />

  <WorkQueue
    title="Akan jatuh tempo"
    description="Jadwal tinjauannya kurang dari dua pekan lagi."
    items={dashboard.dueSoon}
    emptyMessage="Tidak ada yang akan jatuh tempo dalam dua pekan ke depan."
    showDue
  />

  <WorkQueue
    title="Draft terlama"
    description="Draft yang paling lama tidak disentuh."
    items={dashboard.drafts}
    emptyMessage="Tidak ada draft yang tertinggal."
  />

  <section class="admin-panel">
    <h2>Ringkasan status</h2>
    <ul class="counts">
      {
        COUNT_LABELS.map(([key, label]) => (
          <li>
            <span class="counts__n">{dashboard.counts[key]}</span>
            <span class="counts__label">{label}</span>
          </li>
        ))
      }
    </ul>
  </section>
</AdminLayout>

<style>
  /* Satu-satunya blok dasbor yang diberi warna bahaya. Kalau setiap antrean
     berwarna, tidak ada yang menonjol — dan yang ini berarti pengunjung sedang
     menemui jalan buntu di halaman publik. */
  .broken {
    border-color: var(--color-danger);
    background-color: color-mix(in srgb, var(--color-danger) 5%, var(--color-surface));
  }

  .broken__desc {
    max-width: 70ch;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .broken ul {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .broken li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    justify-content: space-between;
    font-size: var(--text-small);
  }

  .broken li span {
    color: var(--color-text-muted);
    font-size: var(--text-meta);
  }

  .broken__more {
    margin-top: var(--space-4);
    font-size: var(--text-small);
  }

  .counts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .counts li {
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-surface-muted);
    border-radius: var(--radius-control);
  }

  .counts__n {
    display: block;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .counts__label {
    display: block;
    margin-top: 2px;
    color: var(--color-text-muted);
    font-size: var(--text-meta);
  }
</style>
