---
/** Detail program. Isi pada Fase 3. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PhasePlaceholder from '@/components/ui/PhasePlaceholder.astro';
import { activePrograms } from '@/data/fixtures';

export function getStaticPaths() {
  return activePrograms.map((program) => ({
    params: { slug: program.slug },
    props: { title: program.title, summary: program.summary },
  }));
}

const { title, summary } = Astro.props;
---

<BaseLayout title={title} description={summary} noindex>
  <PhasePlaceholder title={title} phase="Fase 3 — Public Directory Routes" describes={summary} />
</BaseLayout>
