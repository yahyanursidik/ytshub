---
/**
 * Direktori Program.
 * Bentuk: daftar berkelompok per status. Yang paling dibutuhkan pengguna dari
 * program adalah "masih berjalan atau tidak", jadi status yang mengatur struktur
 * halaman — bukan grid yang meratakan semuanya.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import FilterBar, { type FilterGroup } from '@/components/ui/FilterBar.astro';
import EmptySection from '@/components/ui/EmptySection.astro';
import StatusDot from '@/components/ui/StatusDot.astro';
import { listPrograms } from '@/server/content/directory-queries';

const programs = await listPrograms();

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const categories = [...new Set(programs.map((program) => program.category))];
const statuses = [...new Set(programs.map((program) => program.programStatus))];
const statusLabel: Record<string, string> = {
  berjalan: 'Berjalan',
  'akan-datang': 'Akan datang',
  selesai: 'Selesai',
};

const groups: FilterGroup[] = [
  {
    param: 'status',
    legend: 'Status',
    options: statuses.map((status) => ({
      label: statusLabel[status] ?? status,
      value: status,
      count: programs.filter((p) => p.programStatus === status).length,
    })),
  },
  {
    param: 'kategori',
    legend: 'Kategori',
    options: categories.map((category) => ({
      label: category,
      value: slugify(category),
      count: programs.filter((p) => p.category === category).length,
    })),
  },
];
---

<BaseLayout
  title="Program"
  description="Program yang diselenggarakan unit-unit Yayasan Tarbiyah Sunnah, beserta status dan cara mengikutinya."
  canonicalPath="/program"
>
  <PageHeader
    eyebrow="Direktori"
    title="Program YTS"
    lead="Kegiatan berkelanjutan yang diselenggarakan unit-unit YTS. Status menunjukkan apakah program masih berjalan, akan datang, atau sudah selesai."
    crumbs={[{ label: 'Beranda', href: '/' }, { label: 'Program' }]}
  />

  <div class="container">
    <FilterBar groups={groups} basePath="/program" noun="program" />

    {programs.length === 0 && <EmptySection message="Belum ada program yang dipublikasikan." />}

    <ul class="program-list" data-filter-list>
      {
        programs.map((program) => (
          <li
            data-filter-item
            data-status={program.programStatus}
            data-kategori={slugify(program.category)}
          >
            <article>
              <p class="program-list__meta">
                <StatusDot status={program.programStatus} />
                <span class="program-list__category">{program.category}</span>
                <a href={`/unit/${program.unitSlug}`}>{program.unitName}</a>
              </p>
              <h2>
                <a href={`/program/${program.slug}`}>{program.title}</a>
              </h2>
              <p class="program-list__summary">{program.summary}</p>
              <p class="program-list__facts">
                {program.scheduleSummary && <span>{program.scheduleSummary}</span>}
                {program.audiences.length > 0 && (
                  <span>Untuk: {program.audiences.map((a) => a.label).join(', ')}</span>
                )}
              </p>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="filter-empty" data-filter-empty hidden>
      Tidak ada program yang cocok dengan filter ini.
      <a href="/program">Tampilkan semua program</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .program-list {
    padding-block: var(--space-4) var(--space-8);
  }

  .program-list li {
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .program-list__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .program-list__meta a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .program-list__meta a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .program-list__category::before,
  .program-list__meta a::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 0.85em;
    margin-inline-end: var(--space-3);
    background-color: var(--color-border-strong);
    vertical-align: -0.1em;
  }

  .program-list h2 {
    margin-top: var(--space-3);
    max-width: 28ch;
  }

  .program-list h2 a {
    color: inherit;
    text-decoration: none;
  }

  .program-list h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .program-list__summary {
    max-width: 64ch;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .program-list__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-meta);
  }

  .filter-empty {
    padding-block: var(--space-12);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
