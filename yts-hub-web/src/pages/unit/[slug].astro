---
/** Detail unit. Isi pada Fase 3. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PhasePlaceholder from '@/components/ui/PhasePlaceholder.astro';
import { getUnitSlugs } from '@/server/content/public-queries';

export async function getStaticPaths() {
  const units = await getUnitSlugs();
  return units.map((unit) => ({
    params: { slug: unit.slug },
    props: { title: unit.title, summary: unit.summary },
  }));
}

const { title, summary } = Astro.props;
---

<BaseLayout title={title} description={summary} noindex>
  <PhasePlaceholder title={title} phase="Fase 3 — Public Directory Routes" describes={summary} />
</BaseLayout>
