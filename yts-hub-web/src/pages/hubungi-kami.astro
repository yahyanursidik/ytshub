---
/**
 * Hubungi Kami — 02-INFORMATION-ARCHITECTURE.md §2, dan 01-PRODUCT-BRIEF §7
 * ("no dead ends", "jangan menyembunyikan kontak resmi terlalu dalam").
 *
 * Kontak dikelompokkan per unit karena pertanyaan sampai lebih cepat bila langsung
 * ke unit yang berwenang — itu juga jawaban FAQ "Bagaimana menghubungi admin layanan?".
 *
 * Nomor dan email termasuk yang dilarang dikarang (05-HALLMARK §7). Selama unit
 * pemilik belum mengisinya, halaman menyebut kanal apa yang tersedia dan menyatakan
 * nilainya belum ada — bukan menampilkan nomor palsu.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import EmptySection from '@/components/ui/EmptySection.astro';
import Icon from '@/components/ui/Icon.astro';
import { listPublicContacts } from '@/server/content/directory-queries';

const contacts = await listPublicContacts();

const byUnit = new Map<string, { title: string; slug: string; items: typeof contacts }>();
for (const contact of contacts) {
  const entry = byUnit.get(contact.unitSlug) ?? {
    title: contact.unitTitle,
    slug: contact.unitSlug,
    items: [],
  };
  entry.items.push(contact);
  byUnit.set(contact.unitSlug, entry);
}
const groups = [...byUnit.values()];
---

<BaseLayout
  title="Hubungi Kami"
  description="Kanal kontak resmi Yayasan Tarbiyah Sunnah, dikelompokkan per unit yang berwenang menanganinya."
  canonicalPath="/hubungi-kami"
>
  <PageHeader
    eyebrow="Bantuan"
    title="Hubungi Kami"
    lead="Setiap unit menangani pertanyaan di bidangnya sendiri. Menghubungi unit yang tepat membuat jawaban datang lebih cepat."
    crumbs={[{ label: 'Beranda', href: '/' }, { label: 'Hubungi Kami' }]}
  />

  <div class="container">
    <p class="hint">
      Sebelum menghubungi admin, cek dulu <a href="/faq">FAQ</a> — sebagian besar pertanyaan rutin sudah
      terjawab di sana.
    </p>

    {groups.length === 0 && <EmptySection message="Belum ada kanal kontak yang dipublikasikan." />}

    <ul class="contact-groups">
      {
        groups.map((group) => (
          <li>
            <section aria-labelledby={`kontak-${group.slug}`}>
              <h2 id={`kontak-${group.slug}`}>
                <a href={`/unit/${group.slug}`}>{group.title}</a>
              </h2>
              <ul class="channels">
                {group.items.map((contact) => (
                  <li>
                    <span class="channels__label">{contact.label}</span>
                    <span class="channels__channel">{contact.channel}</span>
                    <span class="channels__value">
                      {contact.value ?? 'Menunggu data resmi unit'}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          </li>
        ))
      }
    </ul>

    <section class="fallback" aria-labelledby="fallback-title">
      <h2 id="fallback-title">Tidak menemukan kanal yang tepat?</h2>
      <p>
        Telusuri layanan atau unit yang paling dekat dengan kebutuhan Anda — setiap halaman detail
        mencantumkan kontak unit yang menanganinya.
      </p>
      <p class="fallback__links">
        <a class="link-action" href="/layanan">
          Katalog layanan
          <Icon name="arrow-right" size={15} />
        </a>
        <a class="link-action" href="/unit">
          Direktori unit
          <Icon name="arrow-right" size={15} />
        </a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .hint {
    max-width: 60ch;
    padding-block: var(--space-8) var(--space-4);
    color: var(--color-text-muted);
  }

  .contact-groups {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-4) var(--space-12);
  }

  .contact-groups > li {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .contact-groups h2 {
    font-size: var(--text-h3);
  }

  .contact-groups h2 a {
    color: inherit;
    text-decoration: none;
  }

  .contact-groups h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .channels {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .channels__label {
    font-weight: 600;
  }

  .channels__channel {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .channels__value {
    display: block;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    font-style: italic;
  }

  .fallback {
    padding: var(--space-6);
    margin-block-end: var(--space-12);
    background-color: var(--color-surface-muted);
    border-radius: var(--radius-panel);
  }

  .fallback h2 {
    font-size: var(--text-h3);
  }

  .fallback p {
    max-width: 56ch;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .fallback__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-4);
  }

  @media (min-width: 720px) {
    .contact-groups > li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-8);
      align-items: start;
    }

    .channels {
      margin-top: 0;
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }
</style>
