---
/**
 * Agenda Event.
 * Bentuk: daftar agenda ringkas. Event dibaca sambil memindai — nama, format,
 * penyelenggara — jadi barisnya padat, bukan card besar satu per satu.
 *
 * Tanggal event termasuk yang dilarang dikarang (05-HALLMARK §7). Selama unit
 * pemilik belum mengisinya, halaman menyatakan itu apa adanya.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import FilterBar, { type FilterGroup } from '@/components/ui/FilterBar.astro';
import EmptySection from '@/components/ui/EmptySection.astro';
import { listEvents } from '@/server/content/directory-queries';

const events = await listEvents();

const formatLabel: Record<string, string> = {
  onsite: 'Tatap muka',
  online: 'Daring',
  hybrid: 'Hybrid',
};

const formats = [...new Set(events.map((event) => event.format))];
const groups: FilterGroup[] = [
  {
    param: 'format',
    legend: 'Format',
    options: formats.map((format) => ({
      label: formatLabel[format] ?? format,
      value: format,
      count: events.filter((event) => event.format === format).length,
    })),
  },
];

const dateFormatter = new Intl.DateTimeFormat('id-ID', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Jakarta',
});
---

<BaseLayout
  title="Event"
  description="Agenda kegiatan Yayasan Tarbiyah Sunnah yang terbuka untuk umum."
  canonicalPath="/event"
>
  <PageHeader
    eyebrow="Direktori"
    title="Event YTS"
    lead="Kegiatan yang terbuka untuk umum. Setiap event menyebutkan unit penyelenggara dan cara mengikutinya."
    crumbs={[{ label: 'Beranda', href: '/' }, { label: 'Event' }]}
  />

  <div class="container">
    <FilterBar groups={groups} basePath="/event" noun="event" />

    {events.length === 0 && <EmptySection message="Belum ada event yang dipublikasikan." />}

    <ul class="event-list" data-filter-list>
      {
        events.map((event) => (
          <li data-filter-item data-format={event.format}>
            <a href={`/event/${event.slug}`}>
              <span class="event-list__when">
                {event.startAt ? (
                  <time datetime={event.startAt.toISOString()}>
                    {dateFormatter.format(event.startAt)}
                  </time>
                ) : (
                  <span class="event-list__tbd">Jadwal belum ditetapkan</span>
                )}
              </span>
              <span class="event-list__main">
                <span class="event-list__title">{event.title}</span>
                <span class="event-list__summary">{event.summary}</span>
              </span>
              <span class="event-list__meta">
                {formatLabel[event.format] ?? event.format}
                <span class="event-list__unit">{event.unitName}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="filter-empty" data-filter-empty hidden>
      Tidak ada event yang cocok dengan filter ini. <a href="/event">Tampilkan semua event</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .event-list {
    padding-block: var(--space-4) var(--space-8);
    border-top: 1px solid var(--color-border-strong);
    margin-top: var(--space-4);
  }

  .event-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .event-list a {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6);
    color: var(--color-text);
    text-decoration: none;
  }

  .event-list a:hover .event-list__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .event-list__when {
    color: var(--color-text-muted);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .event-list__tbd {
    font-style: italic;
    text-transform: none;
    letter-spacing: normal;
  }

  .event-list__title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
  }

  .event-list__summary {
    display: block;
    max-width: 62ch;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .event-list__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .event-list__unit::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 0.85em;
    margin-inline-end: var(--space-3);
    background-color: var(--color-border-strong);
    vertical-align: -0.1em;
  }

  .filter-empty {
    padding-block: var(--space-12);
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (min-width: 860px) {
    .event-list a {
      grid-template-columns: 14rem minmax(0, 1fr) 12rem;
      align-items: baseline;
      gap: var(--space-6);
    }

    .event-list__meta {
      justify-content: flex-end;
      text-align: end;
    }
  }
</style>
