---
/**
 * Beranda — narrative sesuai 03-LANDING-PAGE-UIUX.md §2:
 * header → hero/search → quick access → layanan populer → jelajahi YTS →
 * program aktif → FAQ → aplikasi & website → help CTA → footer.
 *
 * Halaman ini satu-satunya tempat yang mengambil data; komponen section menerima
 * hasilnya lewat props dan tetap murni presentasional. Query berjalan sekali saat
 * build, jadi HTML yang dikirim ke pengguna tetap statis (09-A11Y §5 HTML-first).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnnouncementBanner from '@/components/landing/AnnouncementBanner.astro';
import Hero from '@/components/landing/Hero.astro';
import QuickAccess from '@/components/landing/QuickAccess.astro';
import PopularServices from '@/components/landing/PopularServices.astro';
import ExploreYts from '@/components/landing/ExploreYts.astro';
import ActivePrograms from '@/components/landing/ActivePrograms.astro';
import LearningEcosystem from '@/components/landing/LearningEcosystem.astro';
import FaqSection from '@/components/landing/FaqSection.astro';
import AppsAndSites from '@/components/landing/AppsAndSites.astro';
import HelpCta from '@/components/landing/HelpCta.astro';

import {
  getFeaturedPrograms,
  getFeaturedUnits,
  getLearningSystems,
  getPopularFaqs,
  getPopularServices,
  getPublicApplications,
} from '@/server/content/public-queries';
import { getTopQueries } from '@/server/content/search-analytics';
import { getHighlightedAnnouncement } from '@/server/content/announcement-queries';
import { popularQueries as fallbackQueries } from '@/config/navigation';

const [services, units, programs, faqs, applications, topQueries, announcement, learningSystems] =
  await Promise.all([
    getPopularServices(5),
    getFeaturedUnits(4),
    getFeaturedPrograms(3),
    getPopularFaqs(4),
    getPublicApplications(3),
    getTopQueries(4),
    getHighlightedAnnouncement(),
    getLearningSystems(),
  ]);

/**
 * "Sering dicari" diambil dari pencarian yang benar-benar terjadi (07-SEARCH §11),
 * menggantikan daftar tetap yang dipakai sejak Fase 1.
 *
 * Daftar di konfigurasi tetap dipertahankan sebagai cadangan, bukan sebagai
 * peninggalan: situs yang baru terbit belum punya riwayat pencarian sama sekali,
 * dan hero tanpa contoh query membuat kolom pencarian kehilangan petunjuk apa
 * yang bisa diketik. Cadangan ini berhenti dipakai sendirinya begitu ada cukup
 * data nyata — tidak ada saklar yang perlu diingat seseorang untuk dimatikan.
 */
const popularQueries = topQueries.length > 0 ? topQueries : fallbackQueries;
---

<BaseLayout
  title="YTS Hub"
  description="Pusat informasi dan layanan resmi Yayasan Tarbiyah Sunnah. Temukan program, layanan, unit, dan aplikasi YTS dengan cepat."
  canonicalPath="/"
>
  <AnnouncementBanner announcement={announcement} />
  <Hero popularQueries={popularQueries} />
  <QuickAccess />
  <PopularServices services={services} />
  <ExploreYts units={units} />
  <ActivePrograms programs={programs} />
  <LearningEcosystem systems={learningSystems} />
  <FaqSection faqs={faqs} />
  <AppsAndSites applications={applications} />
  <HelpCta />
</BaseLayout>
