---
/**
 * QuickAccess — 03-LANDING-PAGE-UIUX.md §6.
 * Card rules: icon 20-24px, seluruh card clickable, hover translate max 1-2px,
 * dan tidak setiap card punya background berbeda.
 */
import Icon from '@/components/ui/Icon.astro';
import { taskShortcuts } from '@/data/fixtures';
---

<section class="quick section--tight" aria-labelledby="quick-title">
  <div class="container">
    <h2 id="quick-title" class="visually-hidden">Akses cepat</h2>
    <ul class="quick__grid">
      {
        taskShortcuts.map((task) => (
          <li>
            <a class="quick__card" href={task.href}>
              <Icon name={task.icon} size={22} class="quick__icon" />
              <span class="quick__label">{task.label}</span>
              <span class="quick__desc">{task.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .quick {
    padding-block: 0 var(--section-gap);
    border-bottom: 1px solid var(--color-border);
  }

  .quick__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .quick__card {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'icon label'
      '.    desc';
    column-gap: var(--space-3);
    row-gap: var(--space-1);
    height: 100%;
    padding: var(--space-4);
    background-color: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease),
      translate var(--dur-fast) var(--ease);
  }

  .quick__card:hover {
    background-color: var(--color-surface-muted);
    color: var(--color-text);
  }

  .quick__card:active {
    translate: 0 1px;
  }

  /* :global() wajib: SVG dirender oleh komponen Icon di luar scope file ini. */
  .quick__card :global(.quick__icon) {
    grid-area: icon;
    margin-top: 1px;
    color: var(--color-brand);
  }

  .quick__label {
    grid-area: label;
    font-weight: 600;
    line-height: 1.3;
  }

  .quick__desc {
    grid-area: desc;
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--leading-tight);
  }

  @media (max-width: 560px) {
    .quick__card {
      grid-template-areas:
        'icon label'
        'desc desc';
      padding: var(--space-4) var(--space-3);
    }

    .quick__desc {
      margin-top: var(--space-1);
    }
  }

  @media (min-width: 780px) {
    .quick__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .quick__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .quick__card {
      grid-template-columns: 1fr;
      grid-template-areas:
        'icon'
        'label'
        'desc';
      row-gap: var(--space-2);
      padding: var(--space-6) var(--space-4);
    }
  }
</style>
