---
/**
 * Aplikasi & Website — 03-LANDING-PAGE-UIUX.md §11 dan 08-INTEGRATION-AND-ROUTING.md §5.
 * Sebelum redirect, pengguna harus tahu nama sistem, fungsinya, dan tujuan link.
 * Tidak menampilkan informasi teknis internal.
 */
import Icon from '@/components/ui/Icon.astro';
import EmptySection from '@/components/ui/EmptySection.astro';
import type { PublicApplication } from '@/server/content/public-queries';

interface Props {
  applications: PublicApplication[];
}

const { applications } = Astro.props;

const kindLabel: Record<string, string> = {
  aplikasi: 'Aplikasi',
  website: 'Website',
  portal: 'Portal',
};
---

<section class="section apps" aria-labelledby="apps-title">
  <div class="container">
    <div class="section-head">
      <div class="section-head__intro">
        <span class="eyebrow">Aplikasi &amp; Website</span>
        <h2 id="apps-title">Pintu menuju sistem YTS yang sudah berjalan</h2>
        <p>
          YTS Hub tidak menggantikan aplikasi yang ada. Di sini Anda melihat sistem mana yang
          menangani apa, lalu membukanya langsung.
        </p>
      </div>
      <a class="link-action" href="/aplikasi">
        Semua aplikasi &amp; website
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    {applications.length === 0 && (
      <EmptySection message="Belum ada aplikasi atau website yang terdaftar." />
    )}

    <ul class="apps__list">
      {
        applications.map((app) => (
          <li class="app-row">
            <div class="app-row__main">
              <p class="app-row__kind">{kindLabel[app.kind] ?? app.kind}</p>
              <h3 class="app-row__name">{app.name}</h3>
              <p class="app-row__summary">{app.summary}</p>
            </div>
            <a
              class="btn btn--secondary app-row__cta"
              href={app.url}
              target="_blank"
              rel="noopener"
            >
              {app.ctaLabel}
              <Icon name="external" size={16} />
              <span class="visually-hidden">
                {app.name} — membuka situs di luar YTS Hub, di tab baru
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .apps__list {
    display: grid;
    border-top: 1px solid var(--color-border-strong);
  }

  .app-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .app-row__kind {
    color: var(--color-text-muted);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .app-row__name {
    margin-top: var(--space-1);
  }

  .app-row__summary {
    max-width: 58ch;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .app-row__cta {
    flex: none;
    min-height: 44px;
    padding-inline: var(--space-4);
    font-size: var(--text-small);
  }

  @media (min-width: 720px) {
    .app-row {
      flex-wrap: nowrap;
    }

    .app-row__main {
      flex: 1;
    }
  }
</style>
