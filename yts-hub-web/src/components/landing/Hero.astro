---
/**
 * Hero — 03-LANDING-PAGE-UIUX.md §4-5.
 * Satu focal point per viewport: search. Headline tidak boleh mengalahkan search.
 * Latar memakai garis lembut CSS (bukan bitmap, bukan blob, bukan gradient generik).
 *
 * Sejak Fase 4 kolom pencarian di sini adalah komponen yang sama dengan yang
 * dipakai halaman hasil dan FAQ Center, lengkap dengan autocomplete.
 */
import SearchField from '@/components/search/SearchField.astro';

interface Props {
  /**
   * Query yang benar-benar sering diketik pengunjung (07-SEARCH §11).
   * Halaman yang memanggil komponen ini yang mengambilnya, supaya Hero tetap
   * presentasional seperti section landing page lainnya sejak Fase 2.
   */
  popularQueries: string[];
}

const { popularQueries } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__texture" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title">Informasi &amp; Layanan untuk Kebaikan Bersama.</h1>
      <p>Temukan program, layanan, unit, dan aplikasi YTS dengan cepat dan mudah.</p>
    </div>

    <SearchField size="hero" />

    {
      popularQueries.length > 0 && (
        <p class="hero__queries">
          <span>Sering dicari:</span>
          {popularQueries.map((q, i) => (
            <>
              {i > 0 && (
                <span aria-hidden="true" class="hero__sep">
                  ·
                </span>
              )}
              <a href={`/cari?q=${encodeURIComponent(q)}`}>{q}</a>
            </>
          ))}
        </p>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--color-page);
    padding-block: clamp(2.25rem, 1.6rem + 3vw, 4rem) clamp(2rem, 1.4rem + 2.4vw, 3rem);
    /* TIDAK memakai overflow: hidden. Sejak Fase 4 kolom pencarian menurunkan
       daftar saran yang melewati batas bawah hero; dengan overflow: hidden
       daftar itu terpotong tepat di tepi hero dan saran kedua ke bawah tidak
       terbaca. Teksturnya sendiri tidak perlu dikurung — .hero__texture memakai
       inset: 0 sehingga tidak pernah melebihi hero. */
  }

  /* Garis horizontal sangat halus — tekstur kertas, tanpa makna dekoratif palsu. */
  .hero__texture {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--color-border) 0 1px,
      transparent 1px 13px
    );
    opacity: 0.32;
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 0%, transparent 72%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
  }

  .hero__copy h1 {
    max-width: 19ch;
    font-size: var(--text-display);
    line-height: var(--leading-display);
  }

  .hero__copy p {
    max-width: 46ch;
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-body-l);
  }

  /* Tampilan kolom pencarian dimiliki SearchField.astro — termasuk perilaku
     responsifnya. Yang tersisa di sini hanya hal yang khusus hero. */

  /* ---- Query populer: tekstual, bukan chip ---- */
  .hero__queries {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .hero__queries a {
    color: var(--color-text-link);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
  }

  .hero__queries a:hover {
    text-decoration-color: currentColor;
  }

  .hero__sep {
    color: var(--color-border-strong);
  }

  @media (max-width: 600px) {
    .hero__copy h1 {
      max-width: 13ch;
    }
  }
</style>
