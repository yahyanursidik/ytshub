---
/**
 * Filter untuk halaman listing — 02-INFORMATION-ARCHITECTURE.md §9.
 *
 * "Gunakan filter hanya bila daftar sudah membutuhkan penyempitan." Karena itu
 * grup dengan kurang dari dua pilihan tidak dirender sama sekali — filter satu
 * opsi hanya menambah beban visual tanpa fungsi.
 *
 * ## Kenapa filternya berjalan di klien
 *
 * Situs ini di-build statis (09-A11Y §5, HTML-first), jadi server tidak pernah
 * melihat `?kategori=...` — halaman sudah jadi HTML sebelum ada request. Dua
 * alternatifnya masing-masing punya ongkos:
 *
 * - Membuat route statis per kombinasi filter menghasilkan banyak halaman nyaris
 *   kembar; 09-SEO §7 justru meminta state terfilter tidak menambah crawl noise.
 * - Menyalakan SSR hanya untuk filter berarti menukar seluruh keunggulan HTML
 *   statis demi satu fitur.
 *
 * Jadi: seluruh item dirender di HTML, dan skrip kecil di bawah menyembunyikan
 * yang tidak cocok. Konsekuensinya jujur — tanpa JavaScript semua item tampil dan
 * tidak ada filter yang ditandai aktif. Daftarnya tetap lengkap dan terbaca, hanya
 * tidak tersaring. Penanda aktif sengaja TIDAK dirender di server supaya tidak
 * pernah ada keadaan "URL bilang terfilter tapi isinya semua".
 *
 * Item yang difilter memakai atribut `data-<param>` pada elemen `[data-filter-item]`.
 */
export interface FilterOption {
  label: string;
  value: string;
  count: number;
}

export interface FilterGroup {
  /** Nama query param, mis. "kategori". */
  param: string;
  legend: string;
  options: FilterOption[];
}

interface Props {
  groups: FilterGroup[];
  /** Path dasar halaman, mis. "/layanan". */
  basePath: string;
  /** Kata benda untuk pesan hasil, mis. "layanan". */
  noun: string;
}

const { groups, basePath, noun } = Astro.props;

const usefulGroups = groups.filter((group) => group.options.length >= 2);
---

{
  usefulGroups.length > 0 && (
    <div class="filters" data-filter-bar data-base-path={basePath} data-noun={noun}>
      {usefulGroups.map((group) => (
        <fieldset class="filters__group">
          <legend>{group.legend}</legend>
          <ul>
            <li>
              <a href={basePath} data-filter-param={group.param} data-filter-value="">
                Semua
              </a>
            </li>
            {group.options.map((option) => (
              <li>
                <a
                  href={`${basePath}?${group.param}=${encodeURIComponent(option.value)}`}
                  data-filter-param={group.param}
                  data-filter-value={option.value}
                >
                  {option.label}
                  <span class="filters__count">({option.count})</span>
                </a>
              </li>
            ))}
          </ul>
        </fieldset>
      ))}

      <p class="filters__status" data-filter-status hidden role="status" />
    </div>
  )
}

<script>
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const list = document.querySelector<HTMLElement>('[data-filter-list]');

  if (bar && list) {
    const links = [...bar.querySelectorAll<HTMLAnchorElement>('[data-filter-param]')];
    const items = [...list.querySelectorAll<HTMLElement>('[data-filter-item]')];
    const status = bar.querySelector<HTMLElement>('[data-filter-status]');
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    const basePath = bar.dataset.basePath ?? location.pathname;
    const noun = bar.dataset.noun ?? 'item';
    const params = [...new Set(links.map((link) => link.dataset.filterParam!))];

    function apply(search: string, pushState: boolean) {
      const query = new URLSearchParams(search);
      const active = new Map<string, string>();
      for (const param of params) {
        const value = query.get(param);
        if (value) active.set(param, value);
      }

      let visible = 0;
      for (const item of items) {
        // Item cocok bila SETIAP filter aktif terpenuhi. Nilai atribut boleh
        // berisi beberapa nilai dipisah spasi (mis. audiens ganda).
        const matches = [...active.entries()].every(([param, value]) =>
          (item.dataset[param] ?? '').split(' ').includes(value),
        );
        item.hidden = !matches;
        if (matches) visible += 1;
      }

      for (const link of links) {
        const param = link.dataset.filterParam!;
        const value = link.dataset.filterValue ?? '';
        const isActive = value ? active.get(param) === value : !active.has(param);
        if (isActive) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }

      if (status) {
        if (active.size > 0) {
          status.hidden = false;
          status.textContent =
            visible > 0
              ? `Menampilkan ${visible} dari ${items.length} ${noun}.`
              : `Tidak ada ${noun} yang cocok dengan filter ini.`;
        } else {
          status.hidden = true;
          status.textContent = '';
        }
      }

      if (empty) empty.hidden = visible > 0;

      if (pushState) {
        const next = query.toString();
        history.pushState({}, '', next ? `${basePath}?${next}` : basePath);
      }
    }

    bar.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-filter-param]');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      apply(new URL(link.href).search, true);
    });

    window.addEventListener('popstate', () => apply(location.search, false));

    apply(location.search, false);
  }
</script>

<style>
  .filters {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .filters__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .filters__group legend {
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-meta);
    font-weight: 600;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    /* legend tidak ikut flow flex container; float membuatnya sebaris dengan opsi. */
    float: left;
    margin-inline-end: var(--space-4);
    line-height: 2.4;
  }

  .filters__group ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
  }

  .filters__group a {
    display: inline-flex;
    align-items: center;
    /* 44px, bukan 40px: ini control utama halaman listing, bukan link inline
       dalam kalimat, jadi pengecualian WCAG 2.5.8 tidak berlaku. */
    min-height: 44px;
    padding-inline: var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .filters__group a:hover {
    color: var(--color-text);
    border-color: var(--color-border);
  }

  /* Aktif ditandai bobot teks + border, bukan warna saja (09-A11Y §3). */
  .filters__group a[aria-current] {
    color: var(--color-text);
    font-weight: 600;
    border-color: var(--color-brand);
    background-color: var(--color-surface);
  }

  .filters__count {
    /* Jarak dibuat di sini, bukan sebagai spasi di markup: whitespace di awal
       ekspresi JSX dibuang saat render. */
    margin-inline-start: 0.4ch;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .filters__group a[aria-current] .filters__count {
    font-weight: 400;
  }

  .filters__status {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  @media (max-width: 640px) {
    .filters__group {
      align-items: flex-start;
    }

    .filters__group ul {
      /* Baris yang bisa digeser, bukan tumpukan setinggi layar. */
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      padding-block-end: var(--space-1);
      scrollbar-width: thin;
    }

    .filters__group a {
      white-space: nowrap;
      border-color: var(--color-border);
    }
  }
</style>
