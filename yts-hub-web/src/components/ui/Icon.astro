---
/**
 * Icon — satu set konsisten, stroke 1.5, currentColor, 24x24 viewBox.
 * Aturan 04-DESIGN-SYSTEM.md §9: satu icon family, weight seragam, tanpa 3D/glossy/emoji.
 * Icon tidak boleh menjadi satu-satunya pembawa makna (09-A11Y §2).
 */
import type { IconName } from '@/types/content';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>',
  'arrow-right': '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  external:
    '<path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  school:
    '<path d="M3 10 12 5l9 5"/><path d="M5 11v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/><path d="M9 19v-5h6v5"/>',
  lecture:
    '<path d="M4 5h9a3 3 0 0 1 3 3v11a2.5 2.5 0 0 0-2.5-2.5H4Z"/><path d="M20 5v11.5"/><path d="M16 8h4"/>',
  learn:
    '<path d="M12 7 4 9.5 12 12l8-2.5Z"/><path d="M7 11v4.2c0 .8 2.2 2.3 5 2.3s5-1.5 5-2.3V11"/><path d="M20 9.5v4"/>',
  donate:
    '<path d="M12 20s-7-4.4-7-9.2A3.8 3.8 0 0 1 12 8a3.8 3.8 0 0 1 7 2.8C19 15.6 12 20 12 20Z"/>',
  calendar:
    '<rect x="4" y="6" width="16" height="14" rx="2"/><path d="M4 10h16"/><path d="M9 4v4"/><path d="M15 4v4"/>',
  help: '<circle cx="12" cy="12" r="8"/><path d="M9.6 9.5a2.5 2.5 0 0 1 4.8.8c0 1.7-2.4 2-2.4 3.4"/><path d="M12 17h.01"/>',
  'chevron-down': '<path d="m6 9.5 6 6 6-6"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="m6 6 12 12"/><path d="m18 6-12 12"/>',
  document:
    '<path d="M14 4H7a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8Z"/><path d="M14 4v4h4"/><path d="M9 13h6"/><path d="M9 16.5h4"/>',
