---
/**
 * Penanda bahwa SEBAGIAN konten yang tampil masih contoh.
 * 05-HALLMARK-ANTI-SLOP.md §7 — no fake data exposed as real.
 *
 * Sejak alamat sistem resmi dimasukkan, isi situs bercampur: unit yayasan dan
 * registry sistemnya adalah data sungguhan (berkode `YTS-`), sedangkan layanan,
 * program, FAQ, dan event masih contoh (berkode `DEV-`). Peringatan yang
 * menyamaratakan keduanya akan membuat pengelola meragukan alamat yang justru
 * sudah benar — jadi kalimatnya menyebutkan batasnya.
 *
 * Otomatis hilang pada production build.
 */
const show = import.meta.env.DEV;
---

{
  show && (
    <div class="dev-notice" role="note">
      <p>
        <strong>Sebagian data masih contoh.</strong> Unit dan daftar sistem YTS sudah resmi;
        layanan, program, FAQ, dan event masih berasal dari seed pengembangan (bertanda{' '}
        <code>DEV-</code>).
      </p>
    </div>
  )
}

<style>
  .dev-notice {
    background-color: #2b2f2c;
    color: #f0eee6;
    font-size: var(--text-meta);
    text-align: center;
  }

  .dev-notice p {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-2) var(--gutter);
  }

  .dev-notice strong {
    color: #e6c98a;
  }

  .dev-notice code {
    font-size: 0.95em;
  }
</style>
