---
/**
 * Penanda bahwa konten yang tampil berasal dari seed pengembangan, bukan data resmi YTS.
 * 05-HALLMARK-ANTI-SLOP.md §7 — no fake data exposed as real.
 * Otomatis hilang pada production build.
 */
const show = import.meta.env.DEV;
---

{
  show && (
    <div class="dev-notice" role="note">
      <p>
        <strong>Data contoh.</strong> Isi halaman ini berasal dari seed pengembangan (bertanda{' '}
        <code>DEV-</code>), bukan informasi resmi Yayasan Tarbiyah Sunnah.
      </p>
    </div>
  )
}

<style>
  .dev-notice {
    background-color: #2b2f2c;
    color: #f0eee6;
    font-size: var(--text-meta);
    text-align: center;
  }

  .dev-notice p {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-2) var(--gutter);
  }

  .dev-notice strong {
    color: #e6c98a;
  }

  .dev-notice code {
    font-size: 0.95em;
  }
</style>
